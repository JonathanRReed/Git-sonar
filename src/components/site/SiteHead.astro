---
import { BRAND } from "@lib/brand";

interface Props {
	title: string;
	description: string;
	/** Path relative to the site root, e.g. "/" or "/about". */
	path: string;
	robots?: string;
}

const { title, description, path, robots } = Astro.props;
const pageUrl = `${BRAND.siteUrl}${path}`;
const socialImageUrl = `${BRAND.siteUrl}/og-image.png`; // generated by the prebuild step
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC ?? "https://plausible.io/js/script.js";
---

<meta charset="utf-8" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="description" content={description} />
{robots && <meta name="robots" content={robots} />}
<link rel="canonical" href={pageUrl} />
<meta name="author" content={BRAND.author} />
<meta name="theme-color" content="#d3d7d2" />
<title>{title}</title>
{analyticsDomain && <script is:inline defer data-domain={analyticsDomain} src={analyticsSrc}></script>}

<meta property="og:type" content="website" />
<meta property="og:url" content={pageUrl} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={socialImageUrl} />

<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={pageUrl} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={socialImageUrl} />

<script is:inline>
	// After-hours mode: restore the visitor's light switch before first paint.
	try {
		if (localStorage.getItem("gallery-lights") === "off") document.documentElement.dataset.lights = "off";
	} catch (e) {}
</script>

<!--
	Let the empty frame travel from the landing page into the studio. This has to
	be inline: from a linked stylesheet it arrives after the browser has already
	decided to skip the transition.
-->
<style is:inline>
	@media (prefers-reduced-motion: no-preference) {
		@view-transition {
			navigation: auto;
		}
	}
</style>

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,400..800&family=Newsreader:ital,opsz,wght@0,6..72,400..600;1,6..72,400..600&display=swap"
	rel="stylesheet"
/>

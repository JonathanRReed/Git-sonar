---
import "@styles/global.css";
import SiteHead from "@components/site/SiteHead.astro";
import SiteNav from "@components/site/SiteNav.astro";
import SiteFooter from "@components/site/SiteFooter.astro";
import { BRAND } from "@lib/brand";

const defaultProfileImageUrl = "https://img.jonathanrreed.com/personal/jonathan.avif";
const profileImageUrl = import.meta.env.PUBLIC_PROFILE_IMAGE_URL ?? defaultProfileImageUrl;
const structuredData = JSON.stringify({
	"@context": "https://schema.org",
	"@type": "Person",
	name: BRAND.author,
	url: `${BRAND.siteUrl}/about`,
	image: profileImageUrl,
	jobTitle: "Software developer",
	knowsAbout: ["Developer tools", "Generative art", "Local-first software", "Frontend product design"],
	worksFor: { "@type": "Organization", name: BRAND.name },
});

const notes = [
	{
		title: "Why I made it",
		text: `I really just made ${BRAND.name} as a love letter to code. When you spend months on a project you're proud of, it usually just sits in a repo where nobody sees it. This gives you a real thing you can hang up. It's free & I'm not trying to make money off it.`,
	},
	{
		title: "How it works",
		text: "Point it at a local folder, a .git zip, or a public repo link. It reads your commits, branches, and authors right in your browser & draws them into a poster without sending anything to a server.",
	},
	{
		title: "What you get",
		text: "Export a PNG for posting online, an animated SVG for a README, or a PDF sized for a print shop. There's also a shareable link option if you want to reopen the exact same poster later.",
	},
];
---

<html lang="en">
	<head>
		<SiteHead
			title={`About ${BRAND.name} and ${BRAND.author}`}
			description={`${BRAND.author} built ${BRAND.name}, a browser tool that turns a Git commit history into a poster you can print and frame.`}
			path="/about"
		/>
		<script is:inline type="application/ld+json" set:html={structuredData}></script>
	</head>
	<body>
		<main id="main-content">
			<section class="about g-wall" aria-labelledby="about-title">
				<SiteNav current="about" />
				<div class="about__grid">
					<div class="about__text">
						<h1 id="about-title">Hi, I'm Jonathan Reed.</h1>
						<p>I built {BRAND.name} to turn a Git repo's commit history into a poster you can print and frame. It runs entirely in your browser, so your code never gets uploaded.</p>
					</div>

					<figure class="about__portrait">
						<div class="g-frame g-frame--oak">
							<div class="g-mat">
								<img src={profileImageUrl} alt="Portrait of Jonathan Reed" width="720" height="720" loading="eager" />
							</div>
						</div>
						<figcaption class="g-label">
							<b>Jonathan Reed</b>
							<i>Software developer</i>
							Built {BRAND.name}
						</figcaption>
					</figure>
				</div>
			</section>

			<section class="notes" aria-label="About the project">
				{notes.map((note) => (
					<article>
						<h2>{note.title}</h2>
						<p>{note.text}</p>
					</article>
				))}
			</section>

			<section class="about-cta g-wall" aria-labelledby="about-cta-title">
				<h2 id="about-cta-title">Try it on something you built.</h2>
				<div class="about-cta__actions">
					<a class="g-btn g-btn--red" href="/app">Make a poster</a>
					<a class="g-btn g-btn--line" href={BRAND.repoUrl} target="_blank" rel="noopener noreferrer">View the source</a>
				</div>
			</section>
		</main>

		<SiteFooter />

		<style>
			:global(html) {
				background: var(--wall);
			}

			:global(body) {
				background: var(--wall);
				color: var(--ink);
			}

			h1,
			.about-cta h2 {
				margin: 0;
				font-weight: 800;
				font-stretch: 75%;
				letter-spacing: -0.02em;
				line-height: 0.92;
				text-wrap: balance;
			}

			.about__grid {
				display: grid;
				grid-template-columns: minmax(0, 7fr) minmax(14rem, 4fr);
				gap: clamp(2rem, 6vw, 6rem);
				align-items: start;
				width: min(80rem, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: clamp(2.5rem, 7vw, 6rem) 0 clamp(3.5rem, 8vw, 7rem);
			}

			.about__text h1 {
				font-size: clamp(3rem, 6.6vw, 6rem);
			}

			.about__text p {
				max-width: 34rem;
				margin: clamp(1.4rem, 2.6vw, 2.2rem) 0 0;
				font-family: var(--font-serif);
				font-size: clamp(1.15rem, 1.5vw, 1.4rem);
				line-height: 1.45;
			}

			.about__portrait {
				position: relative;
				margin: 0;
			}

			.about__portrait img {
				aspect-ratio: 1;
				object-fit: cover;
			}

			.about__portrait .g-label {
				margin-top: 1.4rem;
			}

			.notes {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: clamp(1.5rem, 4vw, 4rem);
				padding: clamp(3.5rem, 8vw, 7rem) max(1.25rem, calc((100% - 80rem) / 2));
				background: var(--paper);
				color: var(--ink);
				transition: background-color 0.6s ease, color 0.6s ease;
			}

			.notes article {
				padding-top: 1.1rem;
				border-top: 2px solid var(--ink);
			}

			.notes h2 {
				margin: 0;
				font-size: clamp(1.35rem, 2vw, 1.75rem);
				font-weight: 700;
				letter-spacing: -0.01em;
			}

			.notes p {
				max-width: 24rem;
				margin: 0.7rem 0 0;
				font-family: var(--font-serif);
				font-size: 1.08rem;
				line-height: 1.5;
				color: var(--ink-2);
			}

			.about-cta {
				padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(4.5rem, 10vw, 8rem);
			}

			.about-cta h2,
			.about-cta__actions {
				width: min(80rem, calc(100% - 2.5rem));
				margin-inline: auto;
			}

			.about-cta h2 {
				font-size: clamp(2.1rem, 3.6vw, 3.3rem);
			}

			.about-cta__actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
				margin-top: clamp(1.6rem, 3vw, 2.4rem);
			}

			.about-cta .g-btn {
				min-height: 3.25rem;
				padding: 0 1.5rem;
				font-size: 1.08rem;
			}

			@media (max-width: 760px) {
				.about__grid,
				.notes {
					grid-template-columns: 1fr;
				}

				.about__portrait {
					max-width: 18rem;
				}
			}
		</style>
	</body>
</html>

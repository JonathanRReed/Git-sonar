			.button {
				min-height: 48px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				padding: 0 1.25rem;
				border-radius: 999px;
				font-weight: 800;
				text-decoration: none;
				transition: transform 180ms ease, background 180ms ease, border-color 180ms ease, color 180ms ease;
			}

			.button:active,
			.nav-actions a:active,
			.nav-links a:active,
			.bento-card:active {
				transform: scale(0.98);
			}

			.button--primary {
				color: #10110f;
				background: #f2b36d;
				box-shadow: 0 16px 46px rgba(242, 179, 109, 0.24);
			}

			.button--secondary {
				color: #f4f0e8;
				border: 1px solid rgba(244, 240, 232, 0.18);
				background: rgba(244, 240, 232, 0.06);
			}

			.button--secondary:hover {
				transform: translateY(-2px);
				border-color: rgba(143, 211, 199, 0.5);
				background: rgba(143, 211, 199, 0.1);
			}

			.hero-visual {
				position: relative;
				display: grid;
				place-items: center;
				width: 100%;
				min-width: 0;
				justify-self: center;
				align-self: center;
			}

			/* Hero poster fan — three real posters overlapped, floating in */
			.poster-fan {
				position: relative;
				display: flex;
				justify-content: center;
				align-items: flex-end;
				width: 100%;
				height: clamp(26rem, 42vw, 40rem);
				perspective: 1600px;
			}
			.poster-fan__card {
				position: absolute;
				bottom: 0;
				width: clamp(12.5rem, 23vw, 18rem);
				border-radius: 0.7rem;
				overflow: hidden;
				border: 1px solid rgba(244, 240, 232, 0.14);
				background: #0b0c0a;
				box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
				transition: transform 320ms cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 320ms ease, z-index 0s;
				animation: posterRise 900ms cubic-bezier(0.2, 0.8, 0.2, 1) both;
			}
			.poster-fan__art {
				display: block;
				width: 100%;
				height: auto;
			}
			.poster-fan__card--0 {
				transform: translateX(-58%) rotate(-9deg) scale(0.9);
				z-index: 1;
				animation-delay: 60ms;
			}
			.poster-fan__card--1 {
				transform: translateY(-6%) rotate(0deg) scale(1.04);
				z-index: 3;
				box-shadow: 0 40px 100px rgba(0, 0, 0, 0.62);
				animation-delay: 0ms;
			}
			.poster-fan__card--2 {
				transform: translateX(58%) rotate(9deg) scale(0.9);
				z-index: 2;
				animation-delay: 120ms;
			}
			.poster-fan:hover .poster-fan__card--0 { transform: translateX(-72%) rotate(-12deg) scale(0.92); }
			.poster-fan:hover .poster-fan__card--2 { transform: translateX(72%) rotate(12deg) scale(0.92); }
			.poster-fan__card:hover {
				transform: translateY(-16%) rotate(0deg) scale(1.08) !important;
				z-index: 5;
				border-color: rgba(242, 179, 109, 0.55);
				box-shadow: 0 50px 120px rgba(0, 0, 0, 0.7);
			}
			@keyframes posterRise {
				from { opacity: 0; transform: translateY(40px) rotate(0deg) scale(0.86); }
			}
			@media (prefers-reduced-motion: reduce) {
				.poster-fan__card { animation: none; }
			}

			.graph-window {
				position: relative;
				overflow: hidden;
				width: min(100%, 52rem);
				margin-inline: auto;
				justify-self: center;
				border-radius: 1.4rem;
				border: 1px solid rgba(244, 240, 232, 0.14);
				background:
					radial-gradient(circle at 65% 24%, rgba(242, 179, 109, 0.14), transparent 18rem),
					linear-gradient(145deg, rgba(26, 31, 27, 0.9), rgba(7, 8, 7, 0.9));
				box-shadow:
					inset 0 1px 0 rgba(255, 255, 255, 0.08),
					0 40px 100px rgba(0, 0, 0, 0.42);
			}

			.window-top,
			.graph-caption {
				position: relative;
				z-index: 1;
			}

			.window-top {
				display: flex;
				align-items: center;
				gap: 0.45rem;
				padding: 0.85rem 1rem;
				border-bottom: 1px solid rgba(244, 240, 232, 0.1);
			}

			.window-top span {
				width: 0.65rem;
				height: 0.65rem;
				border-radius: 999px;
				background: rgba(244, 240, 232, 0.25);
			}

			.window-top code {
				margin-left: auto;
				color: rgba(244, 240, 232, 0.58);
				font-family: var(--font-mono);
				font-size: 0.78rem;
			}

			.sonar-graph {
				width: 100%;
				display: block;
				padding: 1rem;
			}

			.sonar-graph text {
				fill: rgba(244, 240, 232, 0.78);
				font-family: var(--font-mono);
				font-size: 13px;
			}

			.graph-line {
				fill: none;
				stroke: rgba(143, 211, 199, 0.68);
				stroke-width: 4;
				stroke-linecap: round;
				stroke-dasharray: 12 14;
				animation: dash 22s linear infinite;
			}

			.graph-line--main {
				stroke: rgba(143, 211, 199, 0.82);
				stroke-width: 5;
				stroke-dasharray: none;
			}

			.graph-line--hot {
				stroke: rgba(242, 179, 109, 0.78);
			}

			.commit {
				fill: #f4f0e8;
				stroke: #0b0c0a;
				stroke-width: 5;
				transform-box: fill-box;
				transform-origin: center;
				animation: pulseNode 3.8s ease-in-out infinite;
			}

			.commit-halo {
				fill: rgba(143, 211, 199, 0.08);
				stroke: rgba(143, 211, 199, 0.12);
				stroke-width: 1;
			}

			.commit--branch {
				fill: #8fd3c7;
			}

			.commit--3,
			.commit--7 {
				fill: #f2b36d;
			}

			.branch-label {
				fill: rgba(9, 10, 9, 0.72);
				stroke: rgba(244, 240, 232, 0.16);
			}

			.graph-caption {
				justify-content: space-between;
				gap: 0.75rem;
				padding: 0 1.1rem 1.15rem;
				color: rgba(244, 240, 232, 0.62);
				font-family: var(--font-mono);
				font-size: 0.8rem;
			}

			.scanline {
				position: absolute;
				inset: 7% -3% auto;
				height: 1px;
				background: linear-gradient(90deg, transparent, rgba(143, 211, 199, 0.8), transparent);
				box-shadow: 0 0 32px rgba(143, 211, 199, 0.65);
				z-index: 2;
				animation: scan 5.5s ease-in-out infinite;
			}

			.capability-ledger {
				width: min(92rem, calc(100% - 2rem));
				margin: 0 auto;
				border-block: 1px solid rgba(244, 240, 232, 0.1);
				background:
					linear-gradient(90deg, rgba(143, 211, 199, 0.08), transparent 34%, rgba(242, 179, 109, 0.08)),
					rgba(244, 240, 232, 0.035);
			}

			.ledger-title,
			.ledger-grid,
			.ledger-item {
				display: grid;
			}

			.ledger-title {
				grid-template-columns: 1fr auto;
				gap: 1rem;
				padding: 1rem 1.1rem;
				border-bottom: 1px solid rgba(244, 240, 232, 0.08);
				color: rgba(244, 240, 232, 0.58);
				font-family: var(--font-mono);
				font-size: 0.82rem;
				text-transform: uppercase;
				letter-spacing: 0.08em;

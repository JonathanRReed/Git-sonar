			.inline-orbit span:nth-child(1) {
				width: 0.72rem;
				height: 0.72rem;
				left: 24%;
				top: 50%;
			}

			.inline-orbit span:nth-child(2) {
				width: 0.88rem;
				height: 0.88rem;
				left: 54%;
				top: 28%;
				background: #f2b36d;
			}

			.inline-orbit span:nth-child(3) {
				width: 0.66rem;
				height: 0.66rem;
				right: 18%;
				bottom: 28%;
				background: #8fd3c7;
			}

			.hero-lede,
			.section-heading p,
			.pinned-copy p,
			.final-cta p,
			.bento-card p,
			.workflow-card p,
			.footer p {
				color: rgba(244, 240, 232, 0.7);
				font-size: clamp(1.03rem, 1.3vw, 1.22rem);
				line-height: 1.65;
				text-wrap: pretty;
			}

			.hero-lede {
				max-width: 34rem;
				margin: 1.6rem 0 0;
			}

			.hero-actions {
				justify-content: flex-start;
				flex-wrap: wrap;

				opacity: 0;
				transform: translateY(28px);
				transition: opacity 520ms ease, transform 520ms ease;
			}

			.bento-card.is-visible,
			.workflow-card.is-visible,
			.ledger-item.is-visible,
			.section-heading.is-visible,
			.final-cta.is-visible,
			:global(html[data-reduced-motion="true"]) .bento-card,
			:global(html[data-reduced-motion="true"]) .workflow-card,
			:global(html[data-reduced-motion="true"]) .ledger-item,
			:global(html[data-reduced-motion="true"]) .section-heading,
			:global(html[data-reduced-motion="true"]) .final-cta {
				opacity: 1;
				transform: translateY(0);
			}

			@keyframes dash {
				to {
					stroke-dashoffset: -260;
				}
			}

			@keyframes pulseNode {
				0%,
				100% {
					transform: scale(1);
				}
				50% {
					transform: scale(1.16);
				}
			}

			@keyframes scan {
				0%,
				100% {
					transform: translateY(0);
					opacity: 0;
				}
				15%,
				85% {
					opacity: 1;
				}
				50% {
					transform: translateY(30rem);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				*,
				*::before,
				*::after {
					animation-duration: 0.01ms !important;
					animation-iteration-count: 1 !important;
					scroll-behavior: auto !important;
					transition-duration: 0.01ms !important;
				}

				.pinned-copy,
				.workflow-card {
					position: static;
				}
			}

			@media (max-width: 980px) {
				.nav-shell {
					grid-template-columns: 1fr auto;
				}

				.nav-links {
					display: none;
				}

				.hero-section,
				.chapter--workflow,
				.section-heading--split,
				.footer {
					grid-template-columns: 1fr;
				}

				.hero-section {
					min-height: auto;
					gap: 1rem;
				}

				/* Re-center the copy once the hero stacks. */
				.hero-copy {
					text-align: center;
				}

				.hero-copy h1 {
					max-width: none;
				}

				.hero-lede {
					margin-inline: auto;
				}

				.hero-actions {
					justify-content: center;
				}

				.hero-visual {
					max-width: 40rem;
					margin-inline: auto;
				}

				.pinned-copy,
				.workflow-card {
					position: static;
				}

				.workflow-stack {
					padding-top: 0;
				}

				.bento-card,
				.bento-card--wide,
				.bento-card--compact,
				.bento-card--medium,
				.bento-card--tall {
					grid-column: span 6;
					grid-row: auto;
					min-height: 18rem;
				}

				.ledger-grid {
					display: grid;
					grid-template-columns: repeat(2, minmax(0, 1fr));
				}

				.ledger-item:nth-child(2n) {
					border-right: none;
				}

				.footer p {
					justify-self: start;
					text-align: left;
				}
			}

			@media (max-width: 640px) {
				.nav-shell {
					top: 0.5rem;
					width: min(100% - 1rem, 92rem);
					border-radius: 1.2rem;
				}

				.nav-actions a:first-child {
					display: none;
				}

				.brand-mark {
					font-size: 0.95rem;
				}

				.brand-mark__icon {
					width: 2.1rem;
					height: 2.1rem;
				}

				.hero-section,
				.chapter,
				.final-cta,
				.footer {
					width: min(100% - 1.2rem, 92rem);
				}

				.hero-copy h1 {
					font-size: clamp(3rem, 16vw, 5rem);
				}

				.graph-window {
					transform: none;
				}

				.graph-caption {
					align-items: flex-start;
					flex-direction: column;
				}

				.bento-grid {
					grid-template-columns: 1fr;
				}

				.bento-card,
				.bento-card--wide,
				.bento-card--compact,
				.bento-card--medium,
				.bento-card--tall {

				box-shadow: 0 28px 80px rgba(0, 0, 0, 0.28);
			}

			.workflow-card:nth-child(2) {
				top: 9.5rem;
				background:
					radial-gradient(circle at 85% 20%, rgba(242, 179, 109, 0.18), transparent 17rem),
					linear-gradient(150deg, rgba(244, 240, 232, 0.11), rgba(244, 240, 232, 0.04));
			}

			.workflow-card:nth-child(3) {
				top: 11rem;
			}

			.workflow-card span {
				margin-bottom: auto;
				color: rgba(244, 240, 232, 0.46);
				font-family: var(--font-mono);
				font-size: 1rem;
			}

			.final-cta {
				width: min(92rem, calc(100% - 2rem));

			.bento-card p,
			.workflow-card p {
				position: relative;
				z-index: 1;
				max-width: 34rem;
				margin: 1rem 0 0;
			}

			.chapter--workflow {
				display: grid;
				grid-template-columns: minmax(18rem, 0.75fr) minmax(0, 1fr);
				gap: clamp(2rem, 6vw, 6rem);
				align-items: start;
			}

			.pinned-copy {
				position: sticky;
				top: 8rem;
			}

			.scrub-copy {
				--scrub-opacity: 0.28;
				--scrub-y: 18px;
				max-width: 34rem;
				margin-top: 1.35rem;
				opacity: var(--scrub-opacity);
				transform: translateY(var(--scrub-y));
				transition: opacity 90ms linear, transform 90ms linear;
			}

			.workflow-stack {
				display: grid;
				gap: 1rem;
				padding-top: 4rem;
			}

			.workflow-card {
				position: sticky;
				top: 8rem;
				min-height: 24rem;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				padding: clamp(1.4rem, 3vw, 2.3rem);
				border: 1px solid rgba(244, 240, 232, 0.12);
				border-radius: 1rem;
				background:
					radial-gradient(circle at 85% 20%, rgba(143, 211, 199, 0.14), transparent 17rem),

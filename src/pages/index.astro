---
import "@styles/global.css";
import { LANDING_POSTERS, HERO_POSTER_IDS } from "@lib/demo-data/landing-posters";

const siteUrl = "https://gitsonar.jonathanrreed.com";
const socialImageUrl = `${siteUrl}/og-image.png`; // generated by the prebuild step
const analyticsDomain = import.meta.env.PUBLIC_ANALYTICS_DOMAIN;
const analyticsSrc = import.meta.env.PUBLIC_ANALYTICS_SRC ?? "https://plausible.io/js/script.js";

// Build-time posters are rasterized to /public/posters/<id>.webp by the prebuild
// step and referenced here via lazy <img> so index.html stays tiny.
const galleryPosters = LANDING_POSTERS;
const heroPosters = HERO_POSTER_IDS
	.map((id) => LANDING_POSTERS.find((p) => p.id === id))
	.filter((p): p is (typeof LANDING_POSTERS)[number] => Boolean(p));

const bentoCards = [
	{
		className: "bento-card bento-card--wide",
		title: "Eight ways to see a repo",
		text: "Movie one-sheet, album cover, an Unknown-Pleasures pulsar, a Fidenza-style flow field, a year-in-code spiral, a constellation, a festival lineup, a Swiss data print — one history, many art forms.",
		meta: "poster styles",
	},
	{
		className: "bento-card bento-card--tall bento-card--image",
		title: "Private by design",
		text: "Repositories are parsed in your browser — drop a .git ZIP (fully offline) or paste a repo URL (fetched straight from your provider). Your code never touches a Git Sonar server.",
		meta: "local-only",
	},
	{
		className: "bento-card",
		title: "Driven by real signals",
		text: "Commit cadence, churn, authors, merges and branch topology map to color, size, density and motion. Your repo's actual rhythm becomes the composition.",
		meta: "data-driven",
	},
	{
		className: "bento-card bento-card--compact bento-card--accent",
		title: "Print it big",
		text: "A high-resolution PNG for the web, plus true-vector SVG and a print-dimensioned PDF (A4–A1, 18×24, 24×36). Frame it.",
		meta: "print-sized",
	},
	{
		className: "bento-card bento-card--medium",
		title: "Tune the look",
		text: "Switch themes and palettes, nudge a few sliders, reroll the seed. Every poster is captured in its link — reopen it any time; public-repo and demo links reproduce it exactly.",
		meta: "studio controls",
	},
	{
		className: "bento-card bento-card--wide bento-card--terminal",
		title: "Start with a URL or archive",
		text: "Load GitHub, GitLab, Bitbucket, or a zipped .git directory. No CLI setup, no project mutation.",
		meta: "zero install path",
	},
];

const workflow = [
	{
		title: "Load any repo",
		text: "Paste a URL or drop a .git archive. Git Sonar builds the commit graph in your browser — your code never touches a server.",
	},
	{
		title: "Pick a style, make it yours",
		text: "Choose a template, theme and palette, then tune the encoding and reroll the seed until it sings.",
	},
	{
		title: "Export or share",
		text: "Download a high-res PNG, vector SVG or print-dimensioned PDF, copy a link, or grab an SVG badge for your README.",
	},
];

const capabilityRows = [
	["Eight styles", "Cinematic, music, generative & data prints"],
	["Private", "Parsed in-browser — nothing uploaded"],
	["Export", "PNG, vector SVG & print-sized PDF"],
	["Shareable", "Image, link & an SVG README badge"],
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta
			name="description"
			content="Git Sonar turns any Git repository into shareable, printable art — movie posters, album covers, and generative prints generated from your commit history, entirely in your browser. Nothing uploaded."
		/>
		<link rel="canonical" href={`${siteUrl}/`} />
		<meta name="author" content="Jonathan Reed" />
		<title>Git Sonar — turn any repo into art</title>
		{analyticsDomain && (
			<script is:inline defer data-domain={analyticsDomain} src={analyticsSrc}></script>
		)}

		<meta property="og:type" content="website" />
		<meta property="og:url" content={`${siteUrl}/`} />
		<meta
			property="og:title"
			content="Git Sonar — turn any repo into art"
		/>
		<meta
			property="og:description"
			content="Generate movie posters, album covers, and generative prints from any repo's commit history — branches, merges, authors, and cadence become the artwork. Private and browser-based."
		/>
		<meta property="og:image" content={socialImageUrl} />

		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:url" content={`${siteUrl}/`} />
		<meta
			property="twitter:title"
			content="Git Sonar — turn any repo into art"
		/>
		<meta
			property="twitter:description"
			content="Turn any repo — including private and work code — into a shareable, printable poster. Nothing uploaded."
		/>
		<meta property="twitter:image" content={socialImageUrl} />

		<script is:inline type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				"name": "Git Sonar",
				"applicationCategory": "DeveloperApplication",
				"operatingSystem": "Web Browser",
				"description": "Git Sonar turns any Git repository into shareable, printable art — movie posters, album covers, and generative prints generated from your commit history, entirely in your browser. Nothing uploaded.",
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD"
				},
				"featureList": [
					"Generate posters and generative art from Git history",
					"Browser-based repository parsing",
					"Movie, album, and data-print poster templates",
					"High-resolution PNG, vector SVG, and print-dimensioned PDF export",
					"Shareable poster permalinks"
				]
			}
		</script>

		<script is:inline type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "Does Git Sonar work on private or work repositories?",
						"acceptedAnswer": { "@type": "Answer", "text": "Yes. Drop a .git ZIP and it is parsed entirely in your browser — fully offline. Repository URLs are fetched directly from your provider. Either way your code never touches a Git Sonar server, so you can make posters from private and work code that account-based tools can't reach." }
					},
					{
						"@type": "Question",
						"name": "Is Git Sonar free?",
						"acceptedAnswer": { "@type": "Answer", "text": "Yes. Generate and download high-resolution PNG, vector SVG, and print-dimensioned PDF posters for free, right in the browser." }
					},
					{
						"@type": "Question",
						"name": "What can I turn my Git history into?",
						"acceptedAnswer": { "@type": "Answer", "text": "Eight poster styles — movie one-sheet, album cover with a commit tracklist, a Pulsar / Unknown-Pleasures joyplot, a Fidenza-style flow field, a radial year-in-code spiral, a constellation star map, a festival lineup, and a Swiss data print." }
					}
				]
			}
		</script>

		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
		<noscript>
			<style>
				.bento-card, .workflow-card, .ledger-item, .section-heading, .final-cta {
					opacity: 1 !important;
					transform: none !important;
				}
			</style>
		</noscript>
	</head>
	<body>
		<main class="site-shell overflow-x-hidden w-full max-w-full" id="main-content">
			<div class="noise" aria-hidden="true"></div>
			<div class="ambient ambient--one" aria-hidden="true"></div>
			<div class="ambient ambient--two" aria-hidden="true"></div>

			<nav class="nav-shell" aria-label="Primary navigation">
				<a href="/" class="brand-mark" aria-label="Git Sonar home">
					<span class="brand-mark__icon" aria-hidden="true">
						<svg viewBox="0 0 32 32" fill="none">
							<path d="M16 5v22" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
							<circle cx="16" cy="7" r="4" fill="currentColor" />
							<circle cx="9" cy="22" r="4" fill="currentColor" />
							<circle cx="23" cy="22" r="4" fill="currentColor" />
							<path d="M16 13c0 4-7 4-7 9M16 13c0 4 7 4 7 9" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
						</svg>
					</span>
					<span>Git Sonar</span>
				</a>

				<div class="nav-links" aria-label="Page sections">
					<a href="#gallery">Gallery</a>
					<a href="#workflow">How it works</a>
					<a href="/about">About</a>
				</div>

				<div class="nav-actions">
					<a
						href="https://github.com/JonathanRReed/Git-sonar"
						target="_blank"
						rel="noopener noreferrer"
					>
						GitHub
					</a>
					<a class="nav-cta" href="/app">Open app</a>
				</div>
			</nav>

			<section class="hero-section" aria-labelledby="hero-title">
				<div class="hero-copy">
					<p class="eyebrow">Turn any repo into art</p>
					<h1 id="hero-title">
						Your Git history, as art.
						<span class="inline-orbit" aria-hidden="true">
							<span></span>
							<span></span>
							<span></span>
						</span>
					</h1>
					<p class="hero-lede">
						Git Sonar turns any commit history — branches, merges, authors, cadence — into a movie poster, album cover, or generative print. Entirely in your browser. Nothing uploaded.
					</p>
					<div class="hero-actions" aria-label="Primary actions">
						<a class="button button--primary" href="/app?view=poster">Open the studio</a>
						<a class="button button--secondary" href="#gallery">See the gallery</a>
					</div>
				</div>

				<div class="hero-visual" aria-label="Three example posters generated from one repository">
					<div class="poster-fan">
						{heroPosters.map((p, i) => (
							<a class={`poster-fan__card poster-fan__card--${i}`} href={p.remix} aria-label={`Remix the ${p.label} poster`}>
								<img class="poster-fan__art" src={p.src} alt={`${p.label} poster generated from a repository`} loading="eager" decoding="async" />
							</a>
						))}
					</div>
				</div>
			</section>

			<section class="gallery" id="gallery" aria-labelledby="gallery-title">
					<div class="gallery-head">
						<p class="eyebrow">Made from one repo</p>
						<h2 id="gallery-title">Eight ways to frame a history.</h2>
						<p>Every poster below was generated from the same demo repository. Click one to open it in the studio and remix it.</p>
					</div>
					<div class="gallery-grid">
						{galleryPosters.map((p) => (
							<a class="gallery-card" href={p.remix} aria-label={`Remix the ${p.label} poster in the studio`}>
								<img class="gallery-card__art" src={p.src} alt={`${p.label} poster generated from a repository`} loading="lazy" decoding="async" />
								<span class="gallery-card__label">
									<span>{p.label}</span>
									<span class="gallery-card__remix">Remix →</span>
								</span>
							</a>
						))}
					</div>
				</section>

				<section class="capability-ledger" aria-label="Product capabilities">
				<div class="ledger-title">
					<span>The pipeline</span>
					<span>local in, visual out</span>
				</div>
				<div class="ledger-grid">
					{capabilityRows.map(([name, detail]) => (
						<div class="ledger-item">
							<strong>{name}</strong>
							<span>{detail}</span>
						</div>
					))}
				</div>
			</section>

			<section class="chapter chapter--read" id="read" aria-labelledby="read-title">
				<div class="section-heading">
					<p class="eyebrow">The styles</p>
					<h2 id="read-title">Every repo has a poster in it.</h2>
					<p>
						Load a history, choose a style, and let the commits — their cadence, authors, and branches — become the artwork. Eight templates, on-brand palettes, print-sized output.
					</p>
				</div>

				<div class="bento-grid">
					{bentoCards.map((card) => (
						<article class={card.className}>
							<div class="bento-card__meta">{card.meta}</div>
							<h3>{card.title}</h3>
							<p>{card.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="chapter chapter--workflow" id="workflow" aria-labelledby="workflow-title">
				<div class="pinned-copy">
					<p class="eyebrow">Workflow</p>
					<h2 id="workflow-title">From repo to poster in three steps.</h2>
					<p class="scrub-copy">
						Load a repo, pick a style and make it yours, then export a poster, a print, or an animated README badge.
					</p>
				</div>

				<div class="workflow-stack">
					{workflow.map((step, index) => (
						<article class="workflow-card" data-step={index + 1}>
							<span>{String(index + 1).padStart(2, "0")}</span>
							<h3>{step.title}</h3>
							<p>{step.text}</p>
						</article>
					))}
				</div>
			</section>

			<section class="final-cta" aria-labelledby="cta-title">
				<p class="eyebrow">Start reading</p>
				<h2 id="cta-title">Turn your repo into something worth framing.</h2>
				<div class="hero-actions">
					<a class="button button--primary" href="/app?view=poster">Launch Git Sonar</a>
					<a class="button button--secondary" href="https://github.com/JonathanRReed/Git-sonar" target="_blank" rel="noopener noreferrer">View source</a>
				</div>
			</section>

			<footer class="footer">
				<a href="/" class="brand-mark">
					<span class="brand-mark__icon" aria-hidden="true">
						<svg viewBox="0 0 32 32" fill="none">
							<path d="M16 5v22" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
							<circle cx="16" cy="7" r="4" fill="currentColor" />
							<circle cx="9" cy="22" r="4" fill="currentColor" />
							<circle cx="23" cy="22" r="4" fill="currentColor" />
						</svg>
					</span>
					<span>Git Sonar</span>
				</a>
				<div class="footer-links">
					<a href="/app">App</a>
					<a href="/about">About</a>
					<a href="https://github.com/JonathanRReed/Git-sonar" target="_blank" rel="noopener noreferrer">GitHub</a>
					<a href="/robots.txt">Robots</a>
				</div>
				<p>Copyright 2026 Git Sonar. Built with Astro, React, and Canvas.</p>
			</footer>
		</main>

		<script>
			const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

			if (!reduceMotion) {
				const revealTargets = document.querySelectorAll(
					".bento-card, .workflow-card, .ledger-item, .section-heading, .final-cta",
				);

				const revealObserver = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add("is-visible");
								revealObserver.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: "0px 0px -12% 0px", threshold: 0.18 },
				);

				for (const target of revealTargets) {
					revealObserver.observe(target);
				}

				const scrubCopy = document.querySelector<HTMLElement>(".scrub-copy");
				const workflowSection = document.querySelector<HTMLElement>(".chapter--workflow");

				const updateScrub = () => {
					if (!scrubCopy || !workflowSection) return;
					const rect = workflowSection.getBoundingClientRect();
					const distance = window.innerHeight + rect.height;
					const progress = Math.min(Math.max((window.innerHeight - rect.top) / distance, 0), 1);
					scrubCopy.style.setProperty("--scrub-opacity", String(0.28 + progress * 0.72));
					scrubCopy.style.setProperty("--scrub-y", `${18 - progress * 18}px`);
				};

				updateScrub();
				window.addEventListener("scroll", updateScrub, { passive: true });
				window.addEventListener("resize", updateScrub);
			} else {
				document.documentElement.dataset.reducedMotion = "true";
			}
		</script>

		<style>
			:global(html) {
				scroll-behavior: smooth;
				background: #090a0a;
			}

			.site-shell {
				min-height: 100dvh;
				position: relative;
				isolation: isolate;
				overflow: hidden;
				background:
					radial-gradient(circle at 18% 8%, rgba(143, 211, 199, 0.18), transparent 32rem),
					radial-gradient(circle at 86% 12%, rgba(242, 179, 109, 0.14), transparent 30rem),
					linear-gradient(180deg, #080908 0%, #10120f 48%, #090a0a 100%);
				color: #f4f0e8;
				font-family: "Cabinet Grotesk", var(--font-sans);
			}

			.noise {
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				opacity: 0.17;
				background-image:
					linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
				background-size: 4px 4px, 4px 4px;
				mask-image: radial-gradient(circle at center, black, transparent 82%);
			}

			.ambient {
				position: fixed;
				z-index: -2;
				border-radius: 999px;
				filter: blur(90px);
				opacity: 0.55;
				pointer-events: none;
			}

			.ambient--one {
				width: 34rem;
				height: 34rem;
				left: -8rem;
				top: 4rem;
				background: #2f6f63;
			}

			.ambient--two {
				width: 38rem;
				height: 38rem;
				right: -12rem;
				top: 30rem;
				background: #8a5326;
			}

			.nav-shell {
				position: sticky;
				top: 1rem;
				z-index: 20;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				align-items: center;
				gap: 1rem;
				width: min(92rem, calc(100% - 2rem));
				margin: 1rem auto 0;
				padding: 0.7rem;
				border: 1px solid rgba(244, 240, 232, 0.12);
				border-radius: 999px;
				background: rgba(12, 14, 12, 0.72);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 18px 70px rgba(0, 0, 0, 0.28);
				backdrop-filter: blur(20px);
			}

			.brand-mark,
			.nav-links,
			.nav-actions,
			.hero-actions,
			.graph-caption,
			.footer-links {
				display: flex;
				align-items: center;
			}

			.brand-mark {
				gap: 0.7rem;
				color: #f4f0e8;
				text-decoration: none;
				font-weight: 800;
				letter-spacing: 0;
			}

			.brand-mark__icon {
				display: grid;
				place-items: center;
				width: 2.45rem;
				height: 2.45rem;
				border-radius: 50%;
				color: #0b0c0a;
				background: #f2b36d;
				box-shadow: 0 0 34px rgba(242, 179, 109, 0.28);
			}

			.brand-mark__icon svg {
				width: 1.2rem;
				height: 1.2rem;
			}

			.nav-links {
				gap: 0.25rem;
				padding: 0.25rem;
				border-radius: 999px;
				background: rgba(255, 255, 255, 0.045);
			}

			.nav-links a,
			.nav-actions a,
			.footer-links a {
				min-height: 44px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				color: rgba(244, 240, 232, 0.72);
				text-decoration: none;
				font-weight: 700;
				transition: color 180ms ease, background 180ms ease, transform 180ms ease, border-color 180ms ease;
			}

			.nav-links a {
				padding: 0 1rem;
				border-radius: 999px;
			}

			.nav-links a:hover,
			.nav-actions a:hover,
			.footer-links a:hover {
				color: #fffaf2;
			}

			.nav-actions {
				justify-content: flex-end;
				gap: 0.45rem;
			}

			.nav-actions a {
				padding: 0 0.9rem;
				border-radius: 999px;
			}

			.nav-cta {
				color: #10110f !important;
				background: #f2b36d;
				box-shadow: 0 12px 38px rgba(242, 179, 109, 0.22);
			}

			.nav-cta:hover,
			.button--primary:hover {
				transform: translateY(-2px);
				background: #ffd08f;
			}

			.hero-section {
				width: min(92rem, calc(100% - 2rem));
				margin: 0 auto;
				display: grid;
				grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
				align-items: center;
				gap: clamp(1.5rem, 4vw, 3.5rem);
				min-height: calc(100dvh - 6.5rem);
				padding: clamp(2rem, 5vw, 4rem) 0 clamp(2.5rem, 5vw, 4rem);
			}

			.hero-copy {
				width: 100%;
				text-align: left;
			}

			.eyebrow {
				margin: 0 0 1.15rem;
				color: #8fd3c7;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			.hero-copy h1,
			.section-heading h2,
			.pinned-copy h2,
			.final-cta h2 {
				margin: 0;
				max-width: 66rem;
				font-size: clamp(3rem, 7vw, 6.8rem);
				line-height: 0.92;
				font-weight: 800;
				letter-spacing: 0;
				text-wrap: balance;
			}

			/* In the two-column hero the headline wraps within its column. */
			.hero-copy h1 {
				max-width: 14ch;
				font-size: clamp(2.7rem, 5.2vw, 4.9rem);
				line-height: 0.95;
			}

			.inline-orbit {
				position: relative;
				display: inline-grid;
				place-items: center;
				width: clamp(5.5rem, 12vw, 11rem);
				height: clamp(2.1rem, 4.6vw, 4.1rem);
				margin-left: 0.35rem;
				border-radius: 999px;
				vertical-align: middle;
				background:
					linear-gradient(90deg, rgba(143, 211, 199, 0.13) 1px, transparent 1px),
					linear-gradient(rgba(143, 211, 199, 0.09) 1px, transparent 1px),
					radial-gradient(circle at 72% 42%, rgba(242, 179, 109, 0.3), transparent 36%),
					rgba(12, 18, 16, 0.72);
				background-size: 22px 22px, 22px 22px, auto, auto;

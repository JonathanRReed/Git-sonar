				padding: clamp(3rem, 7vw, 6rem);
				border-radius: 1.3rem;
				border: 1px solid rgba(244, 240, 232, 0.13);
				background:
					linear-gradient(120deg, rgba(242, 179, 109, 0.2), transparent 45%),
					radial-gradient(circle at 85% 12%, rgba(143, 211, 199, 0.18), transparent 24rem),
					rgba(244, 240, 232, 0.065);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 34px 100px rgba(0, 0, 0, 0.32);
			}

			.final-cta h2 {
				max-width: 76rem;
			}

			.footer {
				width: min(92rem, calc(100% - 2rem));
				margin: 0 auto;
				padding: 2rem 0 3rem;
				display: grid;
				grid-template-columns: 1fr auto 1fr;
				gap: 1rem;
				align-items: center;
				border-top: 1px solid rgba(244, 240, 232, 0.1);

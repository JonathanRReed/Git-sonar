			.section-heading p {
				max-width: 42rem;
				margin: 1.2rem 0 0;
			}

			.section-heading--split {
				max-width: none;
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.58fr);
				gap: clamp(2rem, 6vw, 6rem);
				align-items: end;
			}

			.bento-grid {
				display: grid;
				grid-template-columns: repeat(12, minmax(0, 1fr));
				grid-auto-flow: dense;
				gap: 1rem;
			}

			.bento-card {
				min-height: 18rem;
				grid-column: span 4;
				display: flex;
				flex-direction: column;
				justify-content: flex-end;
				position: relative;
				overflow: hidden;
				padding: clamp(1.2rem, 3vw, 2rem);
				border-radius: 1rem;
				border: 1px solid rgba(244, 240, 232, 0.11);
				background:
					linear-gradient(160deg, rgba(244, 240, 232, 0.09), rgba(244, 240, 232, 0.035)),
					rgba(12, 14, 12, 0.76);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
				transition: transform 260ms ease, border-color 260ms ease, background 260ms ease;
			}

			.bento-card::before {
				content: "";
				position: absolute;
				inset: 0;
				background: radial-gradient(circle at var(--x, 18%) var(--y, 12%), rgba(143, 211, 199, 0.16), transparent 16rem);
				opacity: 0;
				transition: opacity 260ms ease;
			}

			.bento-card:hover {
				transform: translateY(-6px);
				border-color: rgba(143, 211, 199, 0.36);
				background:
					linear-gradient(160deg, rgba(244, 240, 232, 0.12), rgba(244, 240, 232, 0.04)),
					rgba(12, 14, 12, 0.84);
			}

			.bento-card:hover::before {
				opacity: 1;
			}

			.bento-card--wide {
				grid-column: span 7;
			}

			.bento-card--compact {
				grid-column: span 3;
			}

			.bento-card--medium {
				grid-column: span 5;
			}

			.bento-card--tall {
				grid-column: span 5;
				grid-row: span 2;
				min-height: 37rem;
			}

			.bento-card--image {
				background:
					radial-gradient(circle at 72% 18%, rgba(143, 211, 199, 0.24), transparent 15rem),
					linear-gradient(90deg, rgba(143, 211, 199, 0.11) 1px, transparent 1px),
					linear-gradient(rgba(143, 211, 199, 0.08) 1px, transparent 1px),
					linear-gradient(155deg, rgba(244, 240, 232, 0.11), rgba(244, 240, 232, 0.035));
				background-size: auto, 40px 40px, 40px 40px, auto;
			}

			.bento-card--accent {
				background:
					radial-gradient(circle at 90% 10%, rgba(242, 179, 109, 0.28), transparent 15rem),
					linear-gradient(160deg, rgba(242, 179, 109, 0.18), rgba(244, 240, 232, 0.04));
			}

			.bento-card--terminal {
				background:
					linear-gradient(90deg, rgba(143, 211, 199, 0.12) 1px, transparent 1px),
					linear-gradient(rgba(143, 211, 199, 0.1) 1px, transparent 1px),
					linear-gradient(160deg, rgba(244, 240, 232, 0.09), rgba(244, 240, 232, 0.035));
				background-size: 32px 32px, 32px 32px, auto;

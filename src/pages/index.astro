---
import "@styles/global.css";
import SiteHead from "@components/site/SiteHead.astro";
import SiteNav from "@components/site/SiteNav.astro";
import SiteFooter from "@components/site/SiteFooter.astro";
import { BRAND } from "@lib/brand";
import { LANDING_POSTERS, HERO_POSTER_IDS, showcaseFacts } from "@lib/demo-data/landing-posters";

const facts = showcaseFacts();
const heroPosters = HERO_POSTER_IDS
	.map((id) => LANDING_POSTERS.find((p) => p.id === id))
	.filter((p): p is (typeof LANDING_POSTERS)[number] => Boolean(p));

// How each piece is framed on the wall. Light sheets get a mat; dark ones hang edge to edge.
const framing: Record<string, { oak?: boolean; mat?: boolean }> = {
	pulsar: { oak: true },
	"growth-rings": { mat: true },
	"transit-map": { oak: true, mat: true },
	"flow-field": { mat: true },
	receipt: {},
	"core-sample": { mat: true },
	"punch-card": { oak: true },
	weave: { mat: true },
	radial: { oak: true, mat: true },
	album: {},
	movie: { oak: true },
	festival: { mat: true },
	constellation: {},
	swiss: { oak: true, mat: true },
};

const NUMBER_WORDS = ["zero", "one", "two", "three", "four", "five", "six", "seven", "eight", "nine", "ten", "eleven", "twelve", "thirteen", "fourteen", "fifteen", "sixteen", "seventeen", "eighteen", "nineteen", "twenty"];
const styleCount = LANDING_POSTERS.length;
const styleWord = NUMBER_WORDS[styleCount] ?? String(styleCount);
const styleWordCap = styleWord.charAt(0).toUpperCase() + styleWord.slice(1);
const posterById = (id: string) => LANDING_POSTERS.find((p) => p.id === id);

const steps = [
	{
		title: "Bring a repo",
		text: "Paste a link, open a folder or drop a .git zip. Take it as it is today, or as it stood on a day worth remembering.",
	},
	{
		title: "Choose how it hangs",
		text: "Pick a style, then set the colours, the words and what the marks mean. Roll the dice for a new composition of the same history.",
	},
	{
		title: "Take it home",
		text: "Download a PNG for screens, an SVG for your README, or a PDF at true print size with the fonts built in.",
	},
];

// Paper sizes drawn to scale against each other and a 5 ft bench (1 in = 0.4rem).
const papers = [
	{ name: "A4", w: 8.27, h: 11.69, note: "Desk size", poster: posterById("swiss") },
	{ name: "A3", w: 11.69, h: 16.54, note: "Hallway size", poster: posterById("growth-rings") },
	{ name: "18 × 24 in", w: 18, h: 24, note: "The classic poster", poster: posterById("transit-map") },
	{ name: "24 × 36 in", w: 24, h: 36, note: "One-sheet size", poster: posterById("core-sample") },
];
---

<html lang="en">
	<head>
		<SiteHead
			title={`${BRAND.name}: turn any Git repo into a poster`}
			description={BRAND.description}
			path="/"
		/>

		<script is:inline type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				"name": "Git Sonar",
				"applicationCategory": "DeveloperApplication",
				"operatingSystem": "Web Browser",
				"description": "Git Sonar turns a commit history into a poster you can print and frame. It runs in your browser, so your code is never uploaded.",
				"offers": {
					"@type": "Offer",
					"price": "0",
					"priceCurrency": "USD"
				},
				"featureList": [
					"Generate posters and generative art from Git history",
					"Browser-based repository parsing",
					"Movie, album, and data-print poster templates",
					"High-resolution PNG, vector SVG, and print-dimensioned PDF export",
					"Shareable poster permalinks"
				]
			}
		</script>

		<script is:inline type="application/ld+json">
			{
				"@context": "https://schema.org",
				"@type": "FAQPage",
				"mainEntity": [
					{
						"@type": "Question",
						"name": "Does Git Sonar work on private or work repositories?",
						"acceptedAnswer": { "@type": "Answer", "text": "Yes. Open the project folder or drop a .git ZIP and it is read entirely in your browser, fully offline. Repository links are fetched directly from your provider. Either way your code never touches a Git Sonar server." }
					},
					{
						"@type": "Question",
						"name": "Is Git Sonar free?",
						"acceptedAnswer": { "@type": "Answer", "text": "Yes. Generate and download high-resolution PNG, vector SVG, and print-dimensioned PDF posters for free, right in the browser." }
					},
					{
						"@type": "Question",
						"name": "What can I turn my Git history into?",
						"acceptedAnswer": { "@type": "Answer", "text": "Fourteen poster styles, including growth rings, a transit map of your branches, a core sample, a woven cloth, a punch card of when you work, an itemised receipt, a pulsar ridgeline plot, a flow field, a movie one-sheet and an album cover with a commit tracklist." }
					}
				]
			}
		</script>
	</head>
	<body>
		<a class="skip" href="#main-content">Skip to content</a>
		<main id="main-content">
			<section class="hero g-wall" aria-labelledby="hero-title">
				<SiteNav current="home" />

				<div class="hero__grid">
					<div class="hero__text">
						<h1 id="hero-title">Every repo deserves a retrospective.</h1>
						<p class="hero__lede">{BRAND.description}</p>
						<p class="hero__visit">Admission free. Open source. {styleWordCap} styles on view.</p>
					</div>

					<div class="hero__pieces">
						{heroPosters.map((p, i) => (
							<figure class={`piece piece--${i}`}>
								<a class={`g-frame ${framing[p.id]?.oak ? "g-frame--oak" : ""}`} href={p.remix} aria-label={`Remix the ${p.label} poster in the studio`}>
									{framing[p.id]?.mat ? (
										<div class="g-mat"><img src={p.src} width={p.width} height={p.height} alt={`${p.label} poster made from the Project Atlas sample repo`} loading="eager" decoding="async" /></div>
									) : (
										<img src={p.src} width={p.width} height={p.height} alt={`${p.label} poster made from the Project Atlas sample repo`} loading="eager" decoding="async" />
									)}
								</a>
								<figcaption class="g-label">
									<small>No. {String(LANDING_POSTERS.indexOf(p) + 1).padStart(2, "0")}</small>
									<b>{p.label}</b>
									<i>Project Atlas</i>
									{i === 0 ? `${facts.commits} commits on paper` : `${facts.authors} authors, ${facts.merges} merges`}
								</figcaption>
							</figure>
						))}

						<div class="piece piece--yours">
							<div class="g-frame g-frame--oak yours">
								<form class="g-mat yours__mat" id="yours-form" action="/app" method="get">
									<h2>This frame is yours.</h2>
									<label for="yours-repo">Paste a repo link to see it hung.</label>
									<input class="g-field" id="yours-repo" name="github" type="text" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" placeholder="you/your-repo" />
									<button class="g-btn g-btn--red" type="submit">Make my poster</button>
									<a class="yours__alt yours__alt--inside" href="/app?demo=showcase">or start with the sample repo</a>
								</form>
							</div>
							<div class="g-label yours__label">
								<b>Untitled</b>
								<i>Yours, once you paste a repo</i>
								<a class="yours__alt" href="/app?demo=showcase">or start with the sample repo</a>
							</div>
						</div>
					</div>
				</div>

			</section>

			<section class="collection g-wall" id="collection" aria-labelledby="collection-title">
				<div class="section-head">
					<h2 id="collection-title">One repo, hung {styleWord} ways.</h2>
					<p>
						Every piece here was made from the same sample history, Project Atlas: {facts.commits} commits by {facts.authors} people.
						Anything with a red dot can be remixed in the studio.
					</p>
				</div>

				<div class="salon">
					{LANDING_POSTERS.map((p, i) => (
						<figure class="salon__piece">
							<a class={`g-frame ${framing[p.id]?.oak ? "g-frame--oak" : ""}`} href={p.remix} tabindex="-1" aria-hidden="true">
								{framing[p.id]?.mat ? (
									<div class="g-mat"><img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async" /></div>
								) : (
									<img src={p.src} width={p.width} height={p.height} alt="" loading="lazy" decoding="async" />
								)}
							</a>
							<figcaption>
								<a class="g-label salon__label" href={p.remix} aria-label={`Remix the ${p.label} poster in the studio`}>
									<small>No. {String(i + 1).padStart(2, "0")}</small>
									<b>{p.label}</b>
									<i>{p.medium}</i>
									<span class="salon__remix"><span class="g-dot" aria-hidden="true"></span><span class="salon__remix-text">Remix</span></span>
								</a>
							</figcaption>
						</figure>
					))}
				</div>
			</section>

			<section class="how g-wall" id="how" aria-labelledby="how-title">
				<div class="section-head">
					<h2 id="how-title">How a repo gets hung.</h2>
				</div>
				<ol class="steps">
					{steps.map((step, i) => (
						<li>
							<div class="steps__head">
								<h3>{step.title}</h3>
								<small aria-hidden="true">No. {String(i + 1).padStart(2, "0")}</small>
							</div>
							<p>{step.text}</p>
						</li>
					))}
				</ol>
			</section>

			<section class="private" aria-labelledby="private-title">
				<div class="private__inner">
					<div>
						<h2 id="private-title">Your code never leaves the room.</h2>
						<p>
							There is no {BRAND.name} server to send it to. A folder or a zip is read on your own computer and works offline.
							A repo link is fetched by your browser, straight from GitHub, GitLab or Bitbucket.
						</p>
					</div>
					<div class="g-label private__plaque">
						<b>Conditions of entry</b>
						<i>None.</i>
						No account. No upload. No cost.
					</div>
				</div>
			</section>

			<section class="sizes g-wall" aria-labelledby="sizes-title">
				<div class="section-head">
					<h2 id="sizes-title">Take it home at any size.</h2>
					<p>
Everything below is drawn to one scale, bench included. Every export is vector-sharp, so the same poster holds up from a phone wallpaper to a one-sheet.
					</p>
				</div>
				<div class="elevation">
					<p class="elevation__centre" aria-hidden="true"></p>
					<p class="elevation__height" aria-hidden="true"><span>57 in to centre</span></p>
					<ul class="elevation__row">
						{papers.map((paper) => (
							<li class="sheet" style={`--w:${paper.w};--h:${paper.h}`}>
								<div class="sheet__paper">
									{paper.poster && <img src={paper.poster.src} alt="" loading="lazy" decoding="async" />}
								</div>
								<p><b>{paper.name}</b><span>{paper.note}</span></p>
							</li>
						))}
					</ul>
					<div class="elevation__bench" aria-hidden="true"><i></i><i></i></div>
				</div>
				<p class="elevation__scale">A 5 ft gallery bench, drawn to the same scale</p>
				<p class="sizes__formats">PNG for screens. SVG for the README. PDF for the print shop.</p>
			</section>

			<section class="closing g-wall" aria-labelledby="closing-title">
				<h2 id="closing-title">There is a space on the wall.</h2>
				<div class="closing__actions">
					<a class="g-btn g-btn--red" href="/app">Open the studio</a>
					<a class="g-btn g-btn--line" href={BRAND.repoUrl} target="_blank" rel="noopener noreferrer">View the source</a>
				</div>
			</section>
		</main>

		<SiteFooter />

		<script>
			// The empty frame: send a pasted repo to the studio, on the right provider.
			const form = document.querySelector<HTMLFormElement>("#yours-form");
			const input = document.querySelector<HTMLInputElement>("#yours-repo");

			form?.addEventListener("submit", (event) => {
				event.preventDefault();
				const raw = (input?.value ?? "").trim();
				if (!raw) {
					window.location.assign("/app");
					return;
				}
				const provider = /gitlab\.com/i.test(raw) ? "gitlab" : /bitbucket\.org/i.test(raw) ? "bitbucket" : "github";
				const path = raw
					.replace(/^https?:\/\//i, "")
					.replace(/^(www\.)?(github\.com|gitlab\.com|bitbucket\.org)\//i, "")
					.replace(/\.git$/i, "")
					.replace(/\/+$/, "");
				const params = new URLSearchParams({ [provider]: path });
				window.location.assign(`/app?${params.toString()}`);
			});
		</script>

		<style>
			:global(html) {
				scroll-behavior: smooth;
				background: var(--wall);
			}

			:global(body) {
				background: var(--wall);
				color: var(--ink);
			}

			.skip {
				position: fixed;
				top: 0.5rem;
				left: 0.5rem;
				z-index: 100;
				padding: 0.6rem 1rem;
				background: var(--ink);
				color: #fff;
				font-weight: 700;
				text-decoration: none;
				transform: translateY(-160%);
				transition: transform 0.15s ease;
			}

			.skip:focus {
				transform: translateY(0);
			}

			h1,
			h2 {
				margin: 0;
				font-family: var(--font-sans);
				font-weight: 800;
				font-stretch: 75%;
				letter-spacing: -0.02em;
				line-height: 0.92;
				text-wrap: balance;
			}

			/* ---------- Hero: the wall ---------- */
			.hero {
				position: relative;
				/* The spotlights spill past each piece; keep them inside the room. */
				overflow: clip;
			}

			.hero__grid {
				display: grid;
				grid-template-columns: minmax(0, 8fr) minmax(0, 15fr);
				gap: clamp(1.5rem, 4vw, 4rem);
				align-items: start;
				width: min(80rem, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: clamp(2.5rem, 6vw, 5rem) 0 clamp(1rem, 3vw, 2.5rem);
			}

			.hero__text h1 {
				font-size: clamp(2.7rem, 4.5vw, 4.1rem);
			}

			.hero__lede {
				max-width: 30rem;
				margin: clamp(1.4rem, 2.6vw, 2.2rem) 0 0;
				font-family: var(--font-serif);
				font-size: clamp(1.15rem, 1.5vw, 1.4rem);
				line-height: 1.45;
			}

			.hero__visit {
				margin: clamp(1.1rem, 2vw, 1.6rem) 0 0;
				font-family: var(--font-serif);
				font-size: 1.05rem;
				font-style: italic;
				color: var(--ink-2);
			}

			/* One hang line: three frames of the same size, level top and bottom,
			   each with its label the same drop below. */
			.hero__pieces {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: clamp(0.9rem, 2vw, 1.8rem);
				align-items: start;
			}

			.piece {
				position: relative;
				margin: 0;
			}

			.piece > .g-frame {
				display: flex;
				flex-direction: column;
				aspect-ratio: 3 / 4;
			}

			.piece > .g-frame > .g-mat {
				flex: 1;
				min-height: 0;
			}

			.piece > .g-frame img {
				flex: 1;
				min-height: 0;
				height: 100%;
				object-fit: cover;
			}

			/* A spotlight on the plaster behind each piece. */
			.piece::before {
				content: "";
				position: absolute;
				inset: -30% -34% -12%;
				z-index: 0;
				background: radial-gradient(ellipse closest-side at 50% 45%, var(--spot), transparent);
				pointer-events: none;
				/* The picture lights come on one by one, with a starter's flicker. */
				animation: lights-on 1.1s steps(1, end) both;
			}

			.piece > * {
				position: relative;
				z-index: 1;
			}

			.piece--0::before {
				animation-delay: 0.15s;
			}

			.piece--1::before {
				animation-delay: 0.45s;
			}

			.piece--yours::before {
				animation-delay: 0.8s;
			}

			@keyframes lights-on {
				0% {
					opacity: 0;
				}
				18% {
					opacity: 0.7;
				}
				26% {
					opacity: 0.15;
				}
				40% {
					opacity: 0.9;
				}
				48% {
					opacity: 0.5;
				}
				60%,
				100% {
					opacity: 1;
				}
			}

			.piece .g-frame:hover {
				transform: translateY(-0.3rem);
				box-shadow: 0 2rem 3rem rgba(20, 22, 24, 0.3), 0 0.3rem 0.6rem rgba(20, 22, 24, 0.3);
			}

			/* Hero frames are label-sized, so their labels run the frame's full width. */
			.piece .g-label {
				max-width: none;
				margin-top: 1.4rem;
			}

			.yours {
				view-transition-name: your-frame;
			}

			.yours__mat {
				display: flex;
				flex-direction: column;
				justify-content: center;
				gap: 0.7rem;
				margin: 0;
				padding: clamp(0.9rem, 9%, 1.6rem);
			}

			/* The same condensed display cut as every other heading on the wall. */
			.yours__mat h2 {
				font-size: clamp(1.9rem, 2.9vw, 2.6rem);
				line-height: 0.95;
			}

			/* On a phone the sample link moves inside the frame, under the button. */
			.yours__alt--inside {
				display: none;
				font-family: var(--font-serif);
				font-size: 1rem;
			}

			/* An empty frame has no glass yet, so nothing reflects across the form. */
			.yours::after {
				content: none;
			}

			.yours__mat label {
				text-wrap: balance;
				font-family: var(--font-serif);
				font-size: 0.98rem;
				line-height: 1.35;
				color: var(--ink-2);
			}

			.yours__mat .g-field {
				font-size: 0.92rem;
			}

			.yours__alt {
				color: var(--ink);
				text-decoration: underline;
				text-underline-offset: 0.2em;
			}

			.yours__alt:hover {
				color: var(--ink);
			}

			/* ---------- Shared section head ---------- */
			.section-head {
				width: min(80rem, calc(100% - 2.5rem));
				margin: 0 auto clamp(2.2rem, 5vw, 4rem);
			}

			/* One clear step below the hero headline. */
			.section-head h2,
			.private h2,
			.closing h2 {
				font-size: clamp(2.1rem, 3.6vw, 3.3rem);
			}

			.section-head p {
				max-width: 38rem;
				margin: 1.2rem 0 0;
				font-family: var(--font-serif);
				font-size: clamp(1.08rem, 1.3vw, 1.25rem);
				line-height: 1.5;
				color: var(--ink-2);
			}

			/* ---------- The collection: a salon hang ---------- */
			/* The same wall as the hero: no seam where the two sections meet. */
			.collection {
				padding: clamp(3rem, 6vw, 5rem) 0 clamp(3rem, 7vw, 6rem);
				background: linear-gradient(180deg, var(--wall-end), var(--wall-hi) 18%, var(--wall-end));
			}

			.salon {
				width: min(80rem, calc(100% - 2.5rem));
				margin: 0 auto;
				columns: 4;
				column-gap: clamp(1.2rem, 3vw, 2.6rem);
			}

			.salon__piece {
				margin: 0 0 clamp(2.4rem, 5vw, 4rem);
				break-inside: avoid;
			}

			/* A salon hang: pieces step down the wall, each with the same small label. */
			.salon__piece:nth-child(3n + 2) {
				padding-top: clamp(0rem, 3vw, 2.4rem);
			}

			/* The red dot marks a piece you can remix; one quiet word beside it says so. */
			.salon__remix-text {
				color: var(--ink-2);
			}

			.salon__piece figcaption {
				margin-top: 1.2rem;
			}

			.salon__piece:hover .g-frame {
				transform: translateY(-0.3rem);
				box-shadow: 0 2rem 3rem rgba(20, 22, 24, 0.3), 0 0.3rem 0.6rem rgba(20, 22, 24, 0.3);
			}

			.salon__remix {
				display: flex;
				align-items: center;
				gap: 0.4rem;
				margin-top: 0.45rem;
				font-family: var(--font-sans);
				font-size: 0.78rem;
				font-weight: 600;
			}

			.salon__remix .g-dot {
				transition: transform 0.25s var(--ease-out);
			}

			.salon__label:hover .g-dot,
			.salon__piece:hover .g-dot {
				transform: scale(1.35);
			}

			/* ---------- How it works ---------- */
			.how {
				padding: clamp(3.5rem, 8vw, 7rem) 0 clamp(4rem, 9vw, 8rem);
				background: linear-gradient(180deg, var(--wall-end), var(--wall-hi) 30%, var(--wall-end));
			}

			/* The three steps are printed on wall labels, like everything else here. */
			.steps {
				display: grid;
				grid-template-columns: repeat(3, minmax(0, 1fr));
				gap: clamp(1rem, 2.5vw, 2.5rem);
				width: min(80rem, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: 0;
				list-style: none;
			}

			.steps li {
				--ink: #16181a;
				--ink-2: #43494c;
				position: relative;
				padding: clamp(1.2rem, 2.2vw, 1.9rem);
				background: var(--card);
				color: var(--ink);
				box-shadow: var(--shadow-label);
			}

			.steps__head {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: 1.5rem;
			}

			.steps small {
				flex: none;
				font-size: 0.8rem;
				font-weight: 600;
				font-variant-numeric: tabular-nums;
				color: var(--ink-2);
			}

			.steps h3 {
				margin: 0;
				font-size: clamp(1.35rem, 1.9vw, 1.7rem);
				font-weight: 700;
				letter-spacing: -0.01em;
				line-height: 1.1;
			}

			.steps p {
				max-width: 26rem;
				margin: 0.7rem 0 0;
				font-family: var(--font-serif);
				font-size: 1.14rem;
				line-height: 1.5;
				color: #2f3437;
			}

			/* ---------- Privacy: the night room ---------- */
			/* A second, darker room: the wall simply turns, with a fall of shadow at the corner. */
			.private {
				padding: clamp(4rem, 9vw, 8rem) 0;
				background:
					linear-gradient(180deg, rgba(0, 0, 0, 0.55), transparent 5rem),
					radial-gradient(ellipse 50% 70% at 78% 40%, rgba(255, 255, 255, 0.09), transparent 70%),
					var(--night-wall);
				color: #f1f0ec;
			}

			.private__inner {
				display: grid;
				grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
				gap: clamp(2rem, 6vw, 6rem);
				align-items: end;
				width: min(80rem, calc(100% - 2.5rem));
				margin: 0 auto;
			}

			.private p {
				max-width: 36rem;
				margin: 1.5rem 0 0;
				font-family: var(--font-serif);
				font-size: clamp(1.1rem, 1.35vw, 1.3rem);
				line-height: 1.5;
				color: rgba(241, 240, 236, 0.86);
			}

			.private__plaque {
				justify-self: start;
				font-size: 1rem;
			}

			.private__plaque b {
				font-size: 1.05rem;
			}

			/* ---------- Sizes ---------- */
			.sizes {
				padding: clamp(4rem, 9vw, 8rem) 0 clamp(3rem, 6vw, 5rem);
			}

			/* A gallery elevation at one scale (--u is one inch): sheets on a shared
			   centre line 57 in above the floor line, a 60 x 18 in bench beneath. */
			.elevation {
				--u: min(0.44rem, calc((100vw - 2.5rem) / 84));
				position: relative;
				width: min(80rem, calc(100% - 2.5rem));
				margin: 0 auto;
				border-bottom: 2px solid var(--ink);
			}

			/* The hang line every sheet is centred on, drawn as on an elevation. */
			.elevation__centre {
				position: absolute;
				top: calc(var(--u) * 18);
				left: 0;
				right: 0;
				margin: 0;
				border-top: 1px dashed var(--ink-3);
			}

			/* How high that line is, as a dimension in a gutter of its own. */
			.elevation__height {
				position: absolute;
				top: calc(var(--u) * 18);
				left: 0.5rem;
				width: 9px;
				height: calc(var(--u) * 57);
				margin: 0;
				border-top: 1.5px solid var(--ink);
				border-bottom: 1.5px solid var(--ink);
				background: linear-gradient(var(--ink), var(--ink)) 50% 0 / 1.5px 100% no-repeat;
			}

			.elevation__height span {
				position: absolute;
				left: 15px;
				top: 50%;
				transform: translateY(-50%);
				font-family: var(--font-serif);
				font-size: 0.9rem;
				font-style: italic;
				color: var(--ink-2);
				white-space: nowrap;
			}

			.elevation__row {
				position: relative;
				display: flex;
				justify-content: space-around;
				align-items: center;
				height: calc(var(--u) * 36);
				margin: 0;
				padding: 0 0 0 clamp(0rem, 9vw, 8.5rem);
				list-style: none;
			}

			.sheet {
				position: relative;
				width: calc(var(--u) * var(--w));
				height: calc(var(--u) * var(--h));
			}

			.sheet__paper {
				width: 100%;
				height: 100%;
				overflow: hidden;
				background: var(--card);
				/* A thin black frame, then the shadow it throws. */
				box-shadow:
					0 0 0 calc(var(--u) * 0.45) var(--frame-black),
					calc(var(--lx, 0) * -0.5rem) 0.9rem 1.6rem calc(var(--u) * 0.45) rgba(20, 22, 24, 0.22),
					0 0.1rem 0.3rem calc(var(--u) * 0.45) rgba(20, 22, 24, 0.28);
			}

			.sheet__paper img {
				display: block;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: top;
			}

			.sheet p {
				position: absolute;
				top: calc(100% + 0.7rem);
				left: 50%;
				margin: 0;
				transform: translateX(-50%);
				font-family: var(--font-serif);
				font-size: 0.92rem;
				line-height: 1.3;
				color: var(--ink-2);
				text-align: center;
				white-space: nowrap;
			}

			.sheet b {
				display: block;
				font-family: var(--font-sans);
				font-size: 1rem;
				color: var(--ink);
			}

			.elevation__bench {
				position: relative;
				width: calc(var(--u) * 60);
				height: calc(var(--u) * 18);
				margin: calc(var(--u) * 21) auto 0;
			}

			.elevation__bench::before {
				content: "";
				position: absolute;
				inset: 0 0 auto 0;
				height: calc(var(--u) * 3);
				border-radius: 2px;
				background:
					linear-gradient(90deg, rgba(0, 0, 0, 0.12), transparent 3%, transparent 97%, rgba(0, 0, 0, 0.14)),
					linear-gradient(180deg, #d9b17c, #bf9462 40%, #a17848);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 2px 3px rgba(0, 0, 0, 0.28);
			}

			.elevation__bench i {
				position: absolute;
				top: calc(var(--u) * 3);
				bottom: 0;
				left: 11%;
				width: calc(var(--u) * 2.4);
				background: linear-gradient(90deg, #0f1011, #303235 50%, #151617);
			}

			.elevation__bench i + i {
				left: auto;
				right: 11%;
			}

			.elevation__scale {
				width: min(80rem, calc(100% - 2.5rem));
				margin: 0.9rem auto 0;
				font-family: var(--font-serif);
				font-size: 0.95rem;
				font-style: italic;
				color: var(--ink-2);
				text-align: center;
			}

			.sizes__formats {
				width: min(80rem, calc(100% - 2.5rem));
				margin: clamp(2.2rem, 5vw, 3.5rem) auto 0;
				font-family: var(--font-serif);
				font-size: clamp(1.15rem, 1.6vw, 1.45rem);
				font-style: italic;
			}

			/* ---------- Closing ---------- */
			.closing {
				padding: clamp(3rem, 7vw, 6rem) 0 clamp(4.5rem, 10vw, 8rem);
			}

			.closing h2,
			.closing__actions {
				width: min(80rem, calc(100% - 2.5rem));
				margin-inline: auto;
			}

			.closing__actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
				margin-top: clamp(1.6rem, 3vw, 2.4rem);
			}

			.closing .g-btn {
				min-height: 3.25rem;
				padding: 0 1.5rem;
				font-size: 1.08rem;
			}

			/* ---------- Narrow screens ---------- */
			@media (max-width: 1020px) {
				.hero__grid {
					grid-template-columns: 1fr;
				}

				.salon {
					columns: 3;
				}
			}

			@media (max-width: 720px) {
				.hero__pieces {
					grid-template-columns: 1fr 1fr;
				}

				/* The call to action comes first on a phone. */
				.piece--yours {
					grid-column: 1 / -1;
					order: -1;
					max-width: 22rem;
				}

				.yours__mat {
					padding: 1.4rem;
				}

				.piece > .g-frame {
					aspect-ratio: auto;
				}

				.salon {
					columns: 2;
					column-gap: 1rem;
				}

				.salon__label {
					padding: 0.5rem 0.6rem 0.55rem;
					font-size: 0.8rem;
				}

				.salon__label b {
					font-size: 0.86rem;
				}

				.sheet p span,
				.elevation__height,
				.yours__label {
					display: none;
				}

				.yours__alt--inside {
					display: block;
				}


				.steps,
				.private__inner {
					grid-template-columns: 1fr;
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.piece::before {
					animation: none;
				}
			}
		</style>
	</body>
</html>

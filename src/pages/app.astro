---
import "@styles/global.css";
import "@styles/app.css";
import "@styles/studio.css";
import "@styles/history.css";
import "@styles/LoadingSkeleton.module.css";
import "@styles/TimelineScrubber.module.css";
import SiteHead from "@components/site/SiteHead.astro";
import { BRAND } from "@lib/brand";
import { ImportPanel } from "@components/ImportPanel";
import { GraphCanvas } from "@components/GraphCanvas";
import { CommitDetailsDialog } from "@components/CommitDetailsDialog";
import { ControlsOverlay } from "@components/ControlsOverlay";
import { LiveRegion } from "@components/LiveRegion";
import { TimelineScrubber } from "@components/TimelineScrubber";
import { ErrorBoundary } from "@components/ErrorBoundary";
import { CommitSidebar } from "@components/CommitSidebar";
import { CalendarView } from "@components/CalendarView";
import { PosterStudio } from "@components/PosterStudio";
import { AppShellController } from "@components/AppShellController";
---

<html lang="en">
	<head>
		<SiteHead
			title={`${BRAND.name} studio: make a poster from your repo`}
			description="Turn any repo into a poster from its commit history. It runs in your browser, so your code is never uploaded."
			path="/app"
		/>
	</head>

	<body>
		<a href="#main-content" class="skip-link">Skip to content</a>
		<noscript>
			<div class="noscript">
				{BRAND.name} needs JavaScript to read repositories and draw posters. Please turn it on to continue.
			</div>
		</noscript>
		<ErrorBoundary>
			<div class="app" id="app">
				<header class="app-header">
					<button
						type="button"
						class="app-icon-btn mobile-menu-btn"
						id="mobile-menu-toggle"
						aria-label="Show the commit list"
						aria-controls="sidebar"
						aria-expanded="false"
					>
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
							<path d="M4 7h16M4 12h16M4 17h16"></path>
						</svg>
					</button>

					<a href="/" class="app-brand">{BRAND.name}</a>

					<div class="app-stats" id="app-stats" aria-live="polite"></div>

					<div class="g-seg app-views" id="app-views" role="group" aria-label="View" hidden>
						<button type="button" data-view="poster" aria-pressed="true">Poster</button>
						<button type="button" data-view="inspect" aria-pressed="false">History</button>
						<button type="button" data-view="calendar" aria-pressed="false">Calendar</button>
					</div>

					<div class="app-actions">
						<button class="g-switch app-switch" type="button" data-light-switch aria-pressed="true" aria-label="Gallery lights" title="Gallery lights"></button>
						<button type="button" class="app-icon-btn app-sound" data-sound-toggle aria-pressed="true" aria-label="Sounds" title="Sounds">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M4 9.5v5h3.5L12 18V6L7.5 9.5H4z"></path>
								<path class="app-sound__on" d="M15.5 9a4.2 4.2 0 0 1 0 6M18 6.5a7.8 7.8 0 0 1 0 11"></path>
								<path class="app-sound__off" d="M16 9.5l5 5M21 9.5l-5 5"></path>
							</svg>
						</button>
						<button type="button" class="app-icon-btn" id="btn-help" aria-label="Keyboard shortcuts" title="Keyboard shortcuts (?)">
							<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
								<circle cx="12" cy="12" r="9"></circle>
								<path d="M9.4 9.3a2.7 2.7 0 0 1 5.2 1c0 1.8-2.6 2.2-2.6 3.9M12 17.2h.01"></path>
							</svg>
						</button>
						<button type="button" class="g-btn g-btn--line" id="btn-new" style="display: none;">
							<span>Change repo</span>
						</button>
					</div>
				</header>

				<div class="sidebar-overlay" id="sidebar-overlay"></div>

				<main class="app-main" id="main-content" aria-label="Poster studio" tabindex="-1">
					<!-- Front desk (shown until a repo is loaded) -->
					<div class="import-container" id="import-container">
						<ImportPanel client:load />
					</div>

					<!-- Views (shown once a repo is loaded) -->
					<div class="graph-container" id="graph-container" style="display: none;">
						<aside class="sidebar" id="sidebar">
							<CommitSidebar client:load />
						</aside>

						<div class="graph-main">
							<GraphCanvas client:load />
							<ControlsOverlay client:load />
							<TimelineScrubber client:load />
							<CalendarView client:load />
							<PosterStudio client:only="react" />
							<LiveRegion client:load />
						</div>
					</div>
				</main>

				<CommitDetailsDialog client:load />
				<AppShellController client:load />
			</div>
		</ErrorBoundary>
		<script>
			import "../scripts/lights";
		</script>
	</body>
</html>

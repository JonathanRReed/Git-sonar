---
import "@styles/global.css";
import SiteHead from "@components/site/SiteHead.astro";
import SiteNav from "@components/site/SiteNav.astro";
import SiteFooter from "@components/site/SiteFooter.astro";
import { BRAND } from "@lib/brand";
---

<html lang="en">
	<head>
		<SiteHead
			title={`Nothing hangs here | ${BRAND.name}`}
			description="That page does not exist. The studio is open, though."
			path="/404"
			robots="noindex"
		/>
	</head>
	<body>
		<main class="lost g-wall" id="main-content">
			<SiteNav />
			<section class="lost__grid" aria-labelledby="lost-title">
				<div>
					<h1 id="lost-title">Nothing hangs at this address.</h1>
					<p>The page you asked for is not on view. The studio is open, though, and the collection is one click away.</p>
					<div class="lost__actions">
						<a class="g-btn g-btn--red" href="/app">Open the studio</a>
						<a class="g-btn g-btn--line" href="/#collection">See the collection</a>
					</div>
				</div>
				<figure class="lost__piece" aria-hidden="true">
					<div class="g-frame">
						<div class="g-mat lost__mat"></div>
					</div>
					<figcaption class="g-label">
						<b>Untitled (404)</b>
						<i>Not on view</i>
						Removed, renamed, or never hung
					</figcaption>
				</figure>
			</section>
		</main>

		<SiteFooter />

		<style>
			:global(html) {
				background: var(--wall);
			}

			:global(body) {
				background: var(--wall);
				color: var(--ink);
			}

			.lost {
				min-height: 78dvh;
			}

			.lost__grid {
				display: grid;
				grid-template-columns: minmax(0, 7fr) minmax(12rem, 3fr);
				gap: clamp(2rem, 6vw, 6rem);
				align-items: start;
				width: min(80rem, calc(100% - 2.5rem));
				margin: 0 auto;
				padding: clamp(2.5rem, 7vw, 6rem) 0 clamp(4rem, 9vw, 8rem);
			}

			h1 {
				margin: 0;
				font-size: clamp(3rem, 6.6vw, 6rem);
				font-weight: 800;
				font-stretch: 75%;
				letter-spacing: -0.02em;
				line-height: 0.92;
				text-wrap: balance;
			}

			.lost__grid p {
				max-width: 32rem;
				margin: clamp(1.4rem, 2.6vw, 2.2rem) 0 0;
				font-family: var(--font-serif);
				font-size: clamp(1.15rem, 1.5vw, 1.4rem);
				line-height: 1.45;
			}

			.lost__actions {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
				margin-top: clamp(1.6rem, 3vw, 2.4rem);
			}

			.lost__actions .g-btn {
				min-height: 3.25rem;
				padding: 0 1.5rem;
				font-size: 1.08rem;
			}

			.lost__piece {
				margin: 0;
			}

			.lost__mat {
				aspect-ratio: 4 / 5;
			}

			.lost__piece .g-label {
				margin-top: 1.4rem;
			}

			@media (max-width: 760px) {
				.lost__grid {
					grid-template-columns: 1fr;
				}

				.lost__piece {
					max-width: 14rem;
				}
			}
		</style>
	</body>
</html>

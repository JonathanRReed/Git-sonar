---
import "@styles/global.css";

const siteUrl = "https://gitsonar.jonathanrreed.com";
const socialImageUrl = `${siteUrl}/og-image.png`;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta
			name="description"
			content="The requested Git Sonar page could not be found. Return to the app or the product overview."
		/>
		<meta name="robots" content="noindex" />
		<title>Page not found, Git Sonar</title>
		<meta property="og:type" content="website" />
		<meta property="og:title" content="Page not found, Git Sonar" />
		<meta property="og:description" content="Return to Git Sonar and turn any repo into art in your browser." />
		<meta property="og:image" content={socialImageUrl} />
		<meta property="twitter:card" content="summary_large_image" />
		<meta property="twitter:image" content={socialImageUrl} />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@400,500,700,800&display=swap"
			rel="stylesheet"
		/>
		<link
			href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<main class="not-found-shell">
			<div class="noise" aria-hidden="true"></div>
			<nav class="nav-shell" aria-label="Primary navigation">
				<a href="/" class="brand-mark" aria-label="Git Sonar home">
					<span class="brand-mark__icon" aria-hidden="true">
						<svg viewBox="0 0 32 32" fill="none">
							<path d="M16 5v22" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" />
							<circle cx="16" cy="7" r="4" fill="currentColor" />
							<circle cx="9" cy="22" r="4" fill="currentColor" />
							<circle cx="23" cy="22" r="4" fill="currentColor" />
						</svg>
					</span>
					<span>Git Sonar</span>
				</a>
				<div class="nav-actions">
					<a href="/">Home</a>
					<a class="nav-cta" href="/app">Open app</a>
				</div>
			</nav>

			<section class="not-found-hero" aria-labelledby="not-found-title">
				<div>
					<p class="eyebrow">404</p>
					<h1 id="not-found-title">This commit path does not exist.</h1>
					<p>
						The route is missing, but the app is ready. Return to Git Sonar and load a repository history locally.
					</p>
					<div class="actions">
						<a class="button button--primary" href="/app">Open Git Sonar</a>
						<a class="button button--secondary" href="/">View overview</a>
					</div>
				</div>
				<div class="route-card" aria-hidden="true">
					<span>HEAD</span>
					<code>refs/routes/missing</code>
					<div></div>
					<div></div>
					<div></div>
				</div>
			</section>
		</main>

		<style>
			:global(html) {
				background: #090a0a;
			}

			.not-found-shell {
				min-height: 100dvh;
				position: relative;
				isolation: isolate;
				overflow: hidden;
				background:
					radial-gradient(circle at 18% 8%, rgba(143, 211, 199, 0.18), transparent 32rem),
					radial-gradient(circle at 86% 12%, rgba(242, 179, 109, 0.14), transparent 30rem),
					linear-gradient(180deg, #080908 0%, #10120f 48%, #090a0a 100%);
				color: #f4f0e8;
				font-family: "Cabinet Grotesk", var(--font-sans);
			}

			.noise {
				position: fixed;
				inset: 0;
				z-index: -1;
				pointer-events: none;
				opacity: 0.17;
				background-image:
					linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
					linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
				background-size: 4px 4px, 4px 4px;
				mask-image: radial-gradient(circle at center, black, transparent 82%);
			}

			.nav-shell {
				position: sticky;
				top: 1rem;
				z-index: 20;
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1rem;
				width: min(92rem, calc(100% - 2rem));
				margin: 1rem auto 0;
				padding: 0.7rem;
				border: 1px solid rgba(244, 240, 232, 0.12);
				border-radius: 999px;
				background: rgba(12, 14, 12, 0.72);
				box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08), 0 18px 70px rgba(0, 0, 0, 0.28);
				backdrop-filter: blur(20px);
			}

			.brand-mark,
			.nav-actions,
			.actions {
				display: flex;
				align-items: center;
			}

			.brand-mark {
				gap: 0.7rem;
				color: #f4f0e8;
				text-decoration: none;
				font-weight: 800;
			}

			.brand-mark__icon {
				display: grid;
				place-items: center;
				width: 2.45rem;
				height: 2.45rem;
				border-radius: 50%;
				color: #0b0c0a;
				background: #f2b36d;
			}

			.brand-mark__icon svg {
				width: 1.2rem;
				height: 1.2rem;
			}

			.nav-actions {
				gap: 0.45rem;
			}

			.nav-actions a,
			.button {
				min-height: 44px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border-radius: 999px;
				font-weight: 800;
				text-decoration: none;
				transition: transform 180ms ease, background 180ms ease, color 180ms ease;
			}

			.nav-actions a {
				padding: 0 0.95rem;
				color: rgba(244, 240, 232, 0.72);
			}

			.nav-cta,
			.button--primary {
				color: #10110f !important;
				background: #f2b36d;
			}

			.button--secondary {
				color: #f4f0e8;
				border: 1px solid rgba(244, 240, 232, 0.18);
				background: rgba(244, 240, 232, 0.06);
			}

			.not-found-hero {
				width: min(92rem, calc(100% - 2rem));
				margin: 0 auto;
				min-height: calc(100dvh - 5rem);
				display: grid;
				grid-template-columns: minmax(0, 1fr) minmax(20rem, 0.42fr);
				gap: clamp(2rem, 7vw, 7rem);
				align-items: center;
				padding: clamp(5rem, 9vw, 8rem) 0;
			}

			.eyebrow {
				margin: 0 0 1.15rem;
				color: #8fd3c7;
				font-family: var(--font-mono);
				font-size: 0.78rem;
				font-weight: 600;
				letter-spacing: 0.08em;
				text-transform: uppercase;
			}

			h1 {
				margin: 0;
				max-width: 64rem;
				font-size: clamp(3.4rem, 8vw, 7.4rem);
				line-height: 0.92;
				font-weight: 800;
				text-wrap: balance;
			}

			p {
				max-width: 42rem;
				color: rgba(244, 240, 232, 0.72);
				font-size: clamp(1.05rem, 1.4vw, 1.24rem);
				line-height: 1.65;
			}

			.actions {
				gap: 0.85rem;
				flex-wrap: wrap;
				margin-top: 2rem;
			}

			.button {
				padding: 0 1.2rem;
			}

			.route-card {
				min-height: 24rem;
				padding: 1.2rem;
				border-radius: 1rem;
				border: 1px solid rgba(244, 240, 232, 0.12);
				background:
					linear-gradient(90deg, rgba(143, 211, 199, 0.08) 1px, transparent 1px),
					linear-gradient(rgba(143, 211, 199, 0.06) 1px, transparent 1px),
					radial-gradient(circle at 70% 18%, rgba(242, 179, 109, 0.18), transparent 12rem),
					rgba(16, 18, 15, 0.72);
				background-size: 34px 34px, 34px 34px, auto, auto;
				box-shadow: 0 34px 100px rgba(0, 0, 0, 0.32);
			}

			.route-card span,
			.route-card code {
				display: block;
				font-family: var(--font-mono);
			}

			.route-card span {
				color: #f2b36d;
				letter-spacing: 0.08em;
			}

			.route-card code {
				margin-top: 0.75rem;
				color: rgba(244, 240, 232, 0.7);
			}

			.route-card div {
				width: 0.9rem;
				height: 0.9rem;
				margin: 3.1rem auto 0;
				border-radius: 999px;
				background: #8fd3c7;
				box-shadow: 0 0 0 12px rgba(143, 211, 199, 0.08);
			}

			.route-card div:nth-of-type(2) {
				background: #f2b36d;
			}

			@media (max-width: 860px) {
				.not-found-hero {
					grid-template-columns: 1fr;
				}

				.route-card {
					max-width: 28rem;
				}
			}
		</style>
	</body>
</html>

{
  "name": "git-sonar",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "astro dev",
    "prebuild": "bun tools/gen-landing-posters.mts",
    "build": "bun tools/gen-landing-posters.mts && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "check": "bun run lint && bun run typecheck && bun run test:run && bun run test:coverage && bun run build && bun run test:e2e",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.0",
    "@tailwindcss/vite": "4.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^7.0.3",
    "culori": "^4.0.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simplex-noise": "^4.0.3",
    "svg2pdf.js": "^2.7.0",
    "tailwindcss": "4.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.0.1",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "@vitest/coverage-v8": "4.1.9",
    "eslint": "^10.6.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "sharp": "^0.35.2",
    "typescript": "^6.0.3",
    "vite": "8.1.0",
    "vitest": "4.1.9"
  }
}

{
  "name": "git-sonar",
  "type": "module",
  "version": "0.1.0",
  "license": "MIT",
  "packageManager": "bun@1.3.9",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "check": "bun run lint && bun run typecheck && bun run test:run && bun run test:coverage && bun run build && bun run test:e2e",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@tailwindcss/vite": "4.3.0",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.4.4",
    "fflate": "^0.8.3",
    "isomorphic-git": "^1.38.4",
    "lucide-react": "^1.17.0",
    "pako": "^2.1.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tailwindcss": "4.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/bun": "^1.3.14",
    "@types/node": "^25.9.1",
    "@types/pako": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/coverage-v8": "4.1.8",
    "eslint": "^10.4.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  }
}

{
  "name": "git-sonar",
  "type": "module",
  "version": "0.1.0",
  "description": "Browser tool for exploring Git history and turning commit data into shareable, printable art",
  "license": "MIT",
  "packageManager": "bun@1.4.0",
  "author": {
    "name": "Jonathan R. Reed",
    "url": "https://jonathanrreed.com/about/"
  },
  "homepage": "https://gitsonar.jonathanrreed.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonathanRReed/Git-sonar.git"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "bun tools/gen-landing-posters.mts",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "typecheck": "astro check && tsc --noEmit -p tsconfig.tools.json",
    "check": "bun run lint && bun run typecheck && bun run test:run && bun run test:coverage && bun run build && bun run test:e2e",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test:e2e": "playwright test",
    "audit:shadscan": "bunx @shadscan/cli@0.17.0 --json --no-interactive --no-roast"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.3.3",
    "culori": "^4.0.2",
    "fflate": "^0.8.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.47.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "simplex-noise": "^4.0.3",
    "svg2pdf.js": "^2.8.1",
    "tailwindcss": "4.3.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@resvg/resvg-js": "^2.6.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.1",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.1.0",
    "sharp": "^0.35.4",
    "typescript": "^7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
